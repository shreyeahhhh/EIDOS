# Copy this file to .env.local (already git-ignored) and fill in real values.
# Never commit .env.local, and never put a real value in this example file.

# --- Public: safe for the browser (inlined at build time) --------------------------------------
# The Supabase project's URL and its publishable ("anon"-scoped) key. Both are meant to be public;
# neither grants access to anything on its own — the FastAPI backend still verifies every token and
# still enforces tenant membership.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Backend-only: never exposed to the browser -------------------------------------------------
# Where the EIDOS FastAPI backend is reachable from this Next.js server (not from the browser).
# Run it locally with: uvicorn eidos.api.main:create_app_from_environment --factory
# (see docs/13_product_backend.md section 12.3 in the main repository for the backend's own
# environment variables — EIDOS_DATABASE_URL, EIDOS_JWKS_URL, EIDOS_MODEL_*, etc.)
EIDOS_API_BASE_URL=http://127.0.0.1:8000
